# Every value below is a placeholder. Copy this file to `.env.local` for local
# development, or set the variables in the Vercel project settings for production.
# Real secrets must never be committed.

# MongoDB connection string. On Vercel use a MongoDB Atlas SRV string, and add
# your production IP (or 0.0.0.0/0) to the Atlas network access list.
MONGODB_URI=mongodb://127.0.0.1:27017/qrbuilder

# Public base URL of this app. It is encoded inside every generated QR code, so it
# must be the real production domain (no trailing slash):
#   NEXT_PUBLIC_APP_URL=https://qr.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-string

# Single admin account (first version). The password is NEVER stored in plaintext,
# only as a scrypt hash. Generate the hash with:
#   npm run hash-password -- "your-password"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=scrypt.replace-with-generated-hash

# Optional. Root folder for template artwork.
# Leave it unset on Vercel: the deployment filesystem is read-only, so the app
# falls back to the writable per-instance /tmp directory. Anything stored there is
# temporary, which is fine for generated designs but means template images do not
# survive a redeploy or a second server instance. Point this at a mounted volume,
# or replace src/lib/storage.ts with an object store, for a permanent fleet.
STORAGE_DIR=./storage
